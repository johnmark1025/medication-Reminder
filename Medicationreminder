using System;
using System.Collections.Generic;
using System.Windows.Forms;

namespace MedicationReminderSimple
{
    public partial class Form1 : Form
    {
        // Store reminders in memory
        List<(string Name, string Time)> reminders = new List<(string, string)>();

        public Form1()
        {
            InitializeComponent();
            timer1.Interval = 60000; // check every 1 minute
            timer1.Start();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // Add time options to the combo box
            comboBox1.Items.Add("8:00 AM");
            comboBox1.Items.Add("9:00 AM");
            comboBox1.Items.Add("10:00 AM");
            comboBox1.Items.Add("12:00 PM");
            comboBox1.Items.Add("3:00 PM");
            comboBox1.Items.Add("6:00 PM");
            comboBox1.Items.Add("9:00 PM");

            MessageBox.Show("Medication Reminder System Loaded!", "Welcome");
        }

        private void btnAdd_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtName.Text) || comboBox1.SelectedItem == null)
            {
                MessageBox.Show("Please enter a medication name and select a time.");
                return;
            }

            string name = txtName.Text;
            string time = comboBox1.SelectedItem.ToString();

            reminders.Add((name, time));
            listBox1.Items.Add($"{name} - {time}");

            txtName.Clear(); 
            comboBox1.SelectedIndex = -1;
        }

        private void timer1_Tick(object sender, EventArgs e)
        {
            string currentTime = DateTime.Now.ToString("h:mm tt"); // e.g. 10:00 AM

            foreach (var reminder in reminders)
            {
                if (reminder.Time == currentTime)
                {
                    MessageBox.Show($"Time to take your medicine: {reminder.Name}",
                        "Medication Reminder",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Information);
                }
            }
        }
    }
}
